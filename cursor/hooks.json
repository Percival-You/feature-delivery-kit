{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node .cursor/hooks/fdp-spec-lock-gate.mjs",
        "matcher": "Write",
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/fdp-converge-check.mjs",
        "loop_limit": 5,
        "timeout": 120
      }
    ]
  }
}
