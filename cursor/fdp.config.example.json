{
  "$schema": "fdp-config-v1",
  "version": 1,
  "docsRoot": ".kiro/docs/tech",
  "codePathGlobs": [
    "project/app/**",
    "project-front/src/**"
  ],
  "activeFeature": "",
  "complexity": "standard",
  "gate": {
    "specLockOnWrite": true,
    "convergeOnStop": true,
    "convergeLoopLimit": 5,
    "allowWriteWithoutActiveFeature": true
  },
  "testCommand": "",
  "testCommandComment": "留空则 stop hook 不跑测试；示例: cd project-front && pnpm vitest --run",
  "exemptWritePaths": [
    "**/spec/**",
    "**/test-cases/**",
    "**/context.md",
    "**/tech-design.md",
    "**/tasks.md",
    "**/converge-report.md",
    "**/.cursor/**",
    "**/feature-delivery-kit/**"
  ]
}
